#!/bin/sh
set -eu

if [ "${EPHEMERA_KEYRING_TEST:-0}" != "1" ]; then
    printf 'unexpected test secret-tool invocation: %s\n' "$*" >&2
    exit 2
fi

operation=${1:-}
provider=
previous=
for argument in "$@"; do
    if [ "$previous" = "provider" ]; then
        provider=$argument
    fi
    previous=$argument
done

if [ -z "$provider" ]; then
    printf 'keyring fixture received no provider: %s\n' "$*" >&2
    exit 2
fi

state_file="$XDG_RUNTIME_DIR/keyring-$provider"
case "$operation" in
    lookup)
        if [ "$provider" = "custom" ]; then
            exit 5
        elif [ -f "$state_file" ]; then
            sed -n '1p' "$state_file"
        elif [ "$provider" = "anthropic" ]; then
            printf '%s\n' 'actual-anthropic-key'
        elif [ "$provider" = "gemini" ]; then
            printf '%s\n' 'actual-gemini-key'
        fi
        ;;
    store)
        key=
        IFS= read -r key || [ -n "$key" ]
        sleep 0.1
        printf '%s\n' "$key" > "$state_file"
        ;;
    clear)
        sleep 0.1
        if [ "$provider" = "anthropic" ]; then
            exit 4
        fi
        rm -f "$state_file"
        ;;
    *)
        printf 'unexpected keyring fixture operation: %s\n' "$operation" >&2
        exit 2
        ;;
esac
