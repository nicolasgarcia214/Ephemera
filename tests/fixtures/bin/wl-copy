#!/bin/sh
set -eu

if [ "$#" -ne 1 ] || [ "$1" != "--" ]; then
    printf 'clipboard export payload reached argv: %s\n' "$*" >&2
    exit 64
fi

body_file=$(mktemp "$XDG_RUNTIME_DIR/ephemera-wl-copy.XXXXXX")
trap 'rm -f "$body_file"' EXIT
cat > "$body_file"

body_size=$(wc -c < "$body_file")
if [ "$body_size" -gt 262144 ] \
        && [ "$(tail -c 17 "$body_file")" = "OVERSIZED_MESSAGE" ]; then
    exit 0
fi

body=$(cat "$body_file")
case "$body" in
    CLIPBOARD_SUCCESS)
        exit 0
        ;;
    CLIPBOARD_FAIL)
        exit 23
        ;;
    CLIPBOARD_SLOW)
        sleep 1
        exit 0
        ;;
    MESSAGE_SECRET_TEXT)
        exit 0
        ;;
    MESSAGE_FAIL)
        exit 23
        ;;
    MESSAGE_SLOW)
        sleep 1
        exit 0
        ;;
    *)
        printf 'unexpected clipboard export body\n' >&2
        exit 65
        ;;
esac
