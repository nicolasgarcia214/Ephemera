#!/bin/sh
set -eu

if [ -n "${EPHEMERA_OLLAMA_LIFECYCLE_DIR:-}" ] \
        && [ "$#" -eq 1 ] && [ "$1" = "serve" ]; then
    printf 'START\n' >> "$EPHEMERA_OLLAMA_LIFECYCLE_DIR/events"
    : > "$EPHEMERA_OLLAMA_LIFECYCLE_DIR/owned-running"
    trap 'printf "STOP\n" >> "$EPHEMERA_OLLAMA_LIFECYCLE_DIR/events"; rm -f "$EPHEMERA_OLLAMA_LIFECYCLE_DIR/owned-running"; exit 0' TERM INT
    while :; do
        sleep 0.05
    done
fi

printf 'unexpected test ollama invocation: %s\n' "$*" >&2
exit 2
