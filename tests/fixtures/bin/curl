#!/bin/sh
set -eu

endpoint=""
for argument do
    case "$argument" in
        --ephemera-stream-error-test)
            endpoint="stream-error"
            ;;
        http://localhost:11434/api/tags|http://127.0.0.1:11434/api/tags)
            endpoint="tags"
            ;;
        http://localhost:11434/api/ps|http://127.0.0.1:11434/api/ps)
            endpoint="ps"
            ;;
    esac
done

case "$endpoint" in
    stream-error)
        printf '%s\n' 'data: {"error":{"message":"<b>api-key=must-not-leak</b>","type":"server_error","code":"fixture_failure"}}'
        sleep 10
        printf '%s\n' 'data: [DONE]'
        ;;
    tags|ps)
        printf '{"models":[]}\n'
        ;;
    *)
        printf 'unexpected test curl invocation: %s\n' "$*" >&2
        exit 2
        ;;
esac
